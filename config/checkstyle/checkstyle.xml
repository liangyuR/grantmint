<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Minimal Checkstyle config for Grantmint.

  Its sole job in M0 is the locale-safety lint mandated by the development guide:
  naked String.toLowerCase()/toUpperCase() (no Locale argument) are forbidden because
  they depend on the JVM default locale (the classic Turkish 'i' trap). Always pass
  Locale.ROOT. See docs/getting-started/DEVELOPMENT_GUIDE.md (Java Hygiene: Locale.ROOT).
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>

    <!-- RegexpSinglelineJava is a TreeWalker check, so it must be nested under TreeWalker. -->
    <module name="TreeWalker">
        <module name="RegexpSinglelineJava">
            <property name="id" value="NakedToLowerCase"/>
            <property name="format" value="\.toLowerCase\(\s*\)"/>
            <property name="message"
                      value="Naked toLowerCase() depends on the default locale; use toLowerCase(Locale.ROOT)."/>
            <property name="ignoreComments" value="true"/>
        </module>

        <module name="RegexpSinglelineJava">
            <property name="id" value="NakedToUpperCase"/>
            <property name="format" value="\.toUpperCase\(\s*\)"/>
            <property name="message"
                      value="Naked toUpperCase() depends on the default locale; use toUpperCase(Locale.ROOT)."/>
            <property name="ignoreComments" value="true"/>
        </module>
    </module>
</module>
